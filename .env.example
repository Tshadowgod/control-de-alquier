# Cadena de conexión de Neon (Postgres).
# En Vercel se configura en Settings -> Environment Variables.
DATABASE_URL="postgresql://usuario:password@host.neon.tech/neondb?sslmode=require"

# Contraseña de administrador para entrar a la aplicación.
ADMIN_PASSWORD="cambiar-esta-contraseña"

# Clave aleatoria y larga con la que se firma la cookie de sesión.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
